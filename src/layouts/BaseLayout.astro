---
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  /** Page language; defaults to site Malay */
  lang?: string;
  /** Optional hreflang pairs, e.g. [{ lang: 'en', path: '/en/...' }] */
  alternates?: { lang: string; path: string }[];
}

import '../styles/global.css';
import NamaBayiToolbar from '../components/NamaBayiToolbar.astro';
import {
  ADSENSE_CLIENT,
  EN_BASE,
  EN_NAMES_BASE,
  NAMA_ISLAM_BASE,
  SITE_LANG,
  SITE_TITLE,
  SITE_URL,
} from '../consts';

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  type = 'website',
  lang = SITE_LANG,
  alternates = [],
} = Astro.props;

const canonical = new URL(canonicalPath, SITE_URL).toString();
const fullTitle = title.includes(SITE_TITLE) ? title : `${title} | ${SITE_TITLE}`;
const ogLocale = lang === 'en' ? 'en_MY' : 'ms_MY';

const path = Astro.url.pathname;
const onNamaBayi = path === NAMA_ISLAM_BASE || path.startsWith(`${NAMA_ISLAM_BASE}/`);
const onEnNames =
  path === EN_BASE ||
  path.startsWith(`${EN_BASE}/`);
const onNamaSection = onNamaBayi || onEnNames;
const isEn = lang === 'en';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="google-site-verification"
      content="ogH5h-nLup4KQ0d1hYwzA7ed4DfPZDN2WBKO7rQ4WAg"
    />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={new URL(a.path, SITE_URL).toString()} />
    ))}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {ADSENSE_CLIENT && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      />
    )}
  </head>
  <body>
    <a class="skip" href="#main">{isEn ? 'Skip to content' : 'Langkau ke kandungan'}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href={isEn ? `${EN_BASE}/` : '/'}>{SITE_TITLE}</a>
        <nav class="nav-primary" aria-label={isEn ? 'Primary' : 'Utama'}>
          <a href={isEn ? `${EN_NAMES_BASE}/` : `${NAMA_ISLAM_BASE}/`}>
            {isEn ? 'Names' : 'Nama-nama'}
          </a>
          {isEn ? <a href="/">BM</a> : <a href={`${EN_BASE}/`}>EN</a>}
        </nav>
      </div>
      {onNamaSection && (
        <div class="wrap nav-secondary-wrap">
          <nav class="nav-secondary" aria-label={isEn ? 'Name sections' : 'Bahagian nama'}>
            {isEn ? (
              <>
                <a href={`${EN_NAMES_BASE}/categories/`}>Name categories</a>
                <a href={`${EN_NAMES_BASE}/boys/`}>Boys</a>
                <a href={`${EN_NAMES_BASE}/girls/`}>Girls</a>
              </>
            ) : (
              <>
                <a href={`${NAMA_ISLAM_BASE}/makna/`}>Kategori Nama</a>
                <a href={`${NAMA_ISLAM_BASE}/lelaki/`}>Lelaki</a>
                <a href={`${NAMA_ISLAM_BASE}/perempuan/`}>Perempuan</a>
              </>
            )}
          </nav>
        </div>
      )}
    </header>
    <main id="main" class="wrap">
      {onNamaBayi && <NamaBayiToolbar lang="ms" />}
      {isEn && onEnNames && <NamaBayiToolbar lang="en" />}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          <strong>{SITE_TITLE}</strong> — panduan untuk Muslim di Malaysia.
          Bermula dengan nama Islam untuk bayi dan anak; topik lain akan ditambah kemudian.
          Maklumat umum sahaja, bukan fatwa.
        </p>
        <p class="footer-links">
          <a href={`${NAMA_ISLAM_BASE}/`}>Nama Islam</a>
          <a href={`${NAMA_ISLAM_BASE}/lelaki/`}>Nama lelaki</a>
          <a href={`${NAMA_ISLAM_BASE}/perempuan/`}>Nama perempuan</a>
          <a href={`${EN_BASE}/`}>English</a>
        </p>
      </div>
    </footer>
  </body>
</html>
