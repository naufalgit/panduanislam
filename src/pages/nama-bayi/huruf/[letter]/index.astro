---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import NameList from '../../../../components/NameList.astro';
import AdSlot from '../../../../components/AdSlot.astro';
import { getLettersWithNames, getNamesByLetter } from '../../../../data/names';

export function getStaticPaths() {
  return getLettersWithNames().map((letter) => ({
    params: { letter: letter.toLowerCase() },
  }));
}

const { letter } = Astro.params;
const L = (letter ?? 'a').toUpperCase();
const names = getNamesByLetter(L);
const allLetters = getLettersWithNames();
const title = `Nama Bayi Islam Bermula Dengan ${L}`;
const description = `Senarai nama bayi Islam yang bermula dengan huruf ${L}. ${names.length} nama beserta maksud dalam Bahasa Melayu.`;
---

<BaseLayout title={title} description={description} canonicalPath={`/nama-bayi/huruf/${L.toLowerCase()}/`}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Laman utama</a> / <a href="/nama-bayi/">Nama bayi</a> / <span>Huruf {L}</span>
  </nav>
  <h1>{title}</h1>
  <p class="lead">
    Nama bayi Islam lelaki dan perempuan yang bermula dengan huruf <strong>{L}</strong>.
  </p>
  <div class="letter-grid" aria-label="Huruf lain">
    {allLetters.map((item) => (
      <a
        class={item === L ? 'active' : undefined}
        href={`/nama-bayi/huruf/${item.toLowerCase()}/`}
      >
        {item}
      </a>
    ))}
  </div>
  <AdSlot slot={`huruf-${L}`} />
  {names.length ? (
    <NameList names={names} />
  ) : (
    <p>Tiada nama untuk huruf ini buat masa ini.</p>
  )}
</BaseLayout>
