---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import NameList from '../../../../components/NameList.astro';
import AdSlot from '../../../../components/AdSlot.astro';
import { THEMES } from '../../../../consts';
import { getNamesByTheme } from '../../../../data/names';

export function getStaticPaths() {
  return Object.keys(THEMES).map((theme) => ({
    params: { theme },
  }));
}

const { theme } = Astro.params;
const themeKey = theme ?? 'rezeki';
const meta = THEMES[themeKey];
const names = getNamesByTheme(themeKey);
const label = meta?.label ?? themeKey;
const title = `${label} — Nama Bayi Islam`;
const description =
  meta?.description ?? `Senarai nama bayi Islam dalam kategori ${themeKey}.`;
---

<BaseLayout title={title} description={description} canonicalPath={`/nama-bayi/makna/${themeKey}/`}
  alternates={[
    { lang: 'ms', path: `/nama-bayi/makna/${themeKey}/` },
    { lang: 'en', path: `/en/categories/${themeKey}/` },
    { lang: 'x-default', path: `/nama-bayi/makna/${themeKey}/` },
  ]}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Laman utama</a> / <a href="/nama-bayi/">Nama bayi</a> /
    <a href="/nama-bayi/makna/">Kategori Nama</a> / <span>{label}</span>
  </nav>
  <h1>{label}</h1>
  <p class="lead">{description}</p>
  <p class="meta">{names.length} nama dalam kategori ini.</p>
  <AdSlot slot={`makna-${themeKey}`} />
  <NameList names={names} />
  <section>
    <h2>Kategori lain</h2>
    <div class="tag-row">
      {Object.entries(THEMES).map(([t, th]) => (
        <a class="tag" href={`/nama-bayi/makna/${t}/`}>{th.label}</a>
      ))}
    </div>
  </section>
</BaseLayout>
