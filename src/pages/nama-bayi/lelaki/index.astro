---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NameList from '../../../components/NameList.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getNamesByGender } from '../../../data/names';

const names = getNamesByGender('lelaki');
const title = 'Nama Bayi Islam Lelaki';
const description = `Senarai ${names.length} nama bayi Islam lelaki beserta maksud dan asal usul. Sesuai untuk ibu bapa di Malaysia.`;
---

<BaseLayout title={title} description={description} canonicalPath="/nama-bayi/lelaki/">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Laman utama</a> / <a href="/nama-bayi/">Nama bayi</a> / <span>Lelaki</span>
  </nav>
  <h1>{title}</h1>
  <p class="lead">
    Koleksi nama bayi Islam untuk anak lelaki — termasuk nama unisex — dengan maksud dalam Bahasa Melayu.
  </p>
  <AdSlot slot="lelaki" />
  <NameList names={names} />
</BaseLayout>
