---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NAMES } from '../../data/names';
import { EN_BASE, EN_NAMES_BASE, NAMA_ISLAM_BASE, SITE_TITLE, THEMES } from '../../consts';

const title = `${SITE_TITLE} — English`;
const description =
  'Islamic names with meanings for Muslim families in Malaysia — boy names, girl names, and meaning categories.';
---

<BaseLayout title={title} description={description} canonicalPath={`${EN_BASE}/`} lang="en">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Bahasa Melayu</a> / <span>English</span>
  </nav>

  <section class="hero">
    <p class="eyebrow">English · Malaysia</p>
    <h1>{SITE_TITLE}</h1>
    <p class="lead">
      Islamic names for Muslim families in Malaysia — meanings, boy and girl lists, and name
      categories.
    </p>
    <div class="hero-actions">
      <a class="btn" href={`${EN_NAMES_BASE}/`}>Islamic Names</a>
      <a class="btn btn-ghost" href={`${EN_NAMES_BASE}/categories/`}>Name categories</a>
    </div>
  </section>

  <section>
    <h2>Explore</h2>
    <div class="card-grid">
      <a class="card" href={`${EN_NAMES_BASE}/`}>
        <h3>All names</h3>
        <p>{NAMES.length}+ names with English meanings.</p>
      </a>
      <a class="card" href={`${EN_NAMES_BASE}/boys/`}>
        <h3>Boy names</h3>
        <p>Muslim boy names with meaning.</p>
      </a>
      <a class="card" href={`${EN_NAMES_BASE}/girls/`}>
        <h3>Girl names</h3>
        <p>Muslim girl names with meaning.</p>
      </a>
      <a class="card" href={`${EN_NAMES_BASE}/categories/`}>
        <h3>Name categories</h3>
        <p>{Object.keys(THEMES).length} categories such as Provision, Mercy, and Light.</p>
      </a>
    </div>
  </section>

  <section class="prose">
    <h2>Bahasa Melayu</h2>
    <p>
      Malay site:
      <a href="/">homepage</a>
      or
      <a href={`${NAMA_ISLAM_BASE}/`}>Nama Islam</a>.
    </p>
  </section>
</BaseLayout>
