---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NAMES } from '../../data/names';
import { EN_BASE, NAMA_BAYI_BASE, SITE_TITLE } from '../../consts';

const title = `${SITE_TITLE} — English`;
const description =
  'Islamic baby names with meanings for Muslim families in Malaysia. More guides will be added over time.';
---

<BaseLayout title={title} description={description} canonicalPath={`${EN_BASE}/`} lang="en">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Bahasa Melayu</a> / <span>English</span>
  </nav>

  <section class="hero">
    <p class="eyebrow">English · Malaysia</p>
    <h1>{SITE_TITLE}</h1>
    <p class="lead">
      Guides for Muslim families in Malaysia. Right now the focus is
      <strong>Islamic baby names</strong>; topics like dua, prayer, and zakat will come later.
    </p>
    <div class="hero-actions">
      <a class="btn" href={`${EN_BASE}/islamic-baby-names/`}>Islamic baby names</a>
      <a class="btn btn-ghost" href={`${EN_BASE}/muslim-boy-names/`}>Boy names</a>
      <a class="btn btn-ghost" href={`${EN_BASE}/muslim-girl-names/`}>Girl names</a>
    </div>
  </section>

  <section>
    <h2>Islamic baby names</h2>
    <div class="card-grid">
      <a class="card" href={`${EN_BASE}/islamic-baby-names/`}>
        <h3>All names</h3>
        <p>{NAMES.length}+ names with English meanings.</p>
      </a>
      <a class="card" href={`${EN_BASE}/muslim-boy-names/`}>
        <h3>Boy names</h3>
        <p>Muslim boy names with meaning.</p>
      </a>
      <a class="card" href={`${EN_BASE}/muslim-girl-names/`}>
        <h3>Girl names</h3>
        <p>Muslim girl names with meaning.</p>
      </a>
    </div>
  </section>

  <section class="prose">
    <h2>Bahasa Melayu</h2>
    <p>
      Most pages are in Malay —
      <a href="/">homepage</a>
      or
      <a href={`${NAMA_BAYI_BASE}/`}>Nama Bayi Islam</a>.
    </p>
  </section>
</BaseLayout>
