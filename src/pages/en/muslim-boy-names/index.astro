---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NameList from '../../../components/NameList.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getNamesByGender } from '../../../data/names';
import { EN_BASE, NAMA_BAYI_BASE } from '../../../consts';

const names = getNamesByGender('lelaki');
const sample = names.slice(0, 24);
const title = 'Muslim Boy Names with Meaning';
const description = `${names.length} Muslim boy names (including unisex) with English meanings — for families in Malaysia.`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`${EN_BASE}/muslim-boy-names/`}
  lang="en"
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={`${EN_BASE}/`}>English</a> /
    <a href={`${EN_BASE}/islamic-baby-names/`}>Islamic baby names</a> /
    <span>Boy names</span>
  </nav>

  <h1>{title}</h1>
  <p class="lead">
    {names.length} Muslim boy names with English meanings. A short sample is below; each name has
    its own page.
  </p>

  <AdSlot slot="en-muslim-boy-names" />

  <section class="prose">
    <h2>Quick tips</h2>
    <p>
      Pick a clear, positive meaning. Try saying the name in Malay and English. See how it sounds
      with your family name.
    </p>
    <p>
      Full Malay list:
      <a href={`${NAMA_BAYI_BASE}/lelaki/`}>Nama bayi Islam lelaki</a>
      ·
      <a href={`${EN_BASE}/muslim-girl-names/`}>Girl names</a>
      ·
      <a href={`${EN_BASE}/islamic-baby-names/`}>All Islamic baby names</a>
    </p>
  </section>

  <section>
    <h2>Sample boy names</h2>
    <NameList names={sample} lang="en" />
    <p style="margin-top: 1.25rem">
      <a class="btn" href={`${EN_BASE}/islamic-baby-names/`}>All Islamic baby names</a>
    </p>
  </section>
</BaseLayout>
