---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NameList from '../../../components/NameList.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { NAMES, getNamesByTheme } from '../../../data/names';
import { EN_BASE, NAMA_BAYI_BASE, THEMES } from '../../../consts';

const boyCount = NAMES.filter((n) => n.gender === 'lelaki' || n.gender === 'unisex').length;
const girlCount = NAMES.filter((n) => n.gender === 'perempuan' || n.gender === 'unisex').length;
const featuredThemes = Object.entries(THEMES).slice(0, 6);
const allNames = [...NAMES].sort((a, b) => a.name.localeCompare(b.name, 'en'));

const title = 'Islamic Baby Names with Meaning';
const description = `${NAMES.length}+ Islamic baby names for boys and girls, with meanings in English — for Muslim parents in Malaysia.`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`${EN_BASE}/islamic-baby-names/`}
  lang="en"
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={`${EN_BASE}/`}>English</a> / <span>Islamic baby names</span>
  </nav>

  <section class="hero">
    <p class="eyebrow">English · Malaysia</p>
    <h1>{title}</h1>
    <p class="lead">
      Islamic baby names for boys and girls — meanings, origins, and categories such as provision,
      mercy, light, and righteousness.
    </p>
    <div class="hero-actions">
      <a class="btn" href={`${EN_BASE}/muslim-boy-names/`}>Boy names</a>
      <a class="btn btn-ghost" href={`${EN_BASE}/muslim-girl-names/`}>Girl names</a>
    </div>
  </section>

  <AdSlot slot="en-islamic-baby-names" />

  <section class="grid-stats">
    <a href={`${EN_BASE}/muslim-boy-names/`} class="stat-card">
      <strong>{boyCount}</strong>
      <span>Boy &amp; unisex names</span>
    </a>
    <a href={`${EN_BASE}/muslim-girl-names/`} class="stat-card">
      <strong>{girlCount}</strong>
      <span>Girl &amp; unisex names</span>
    </a>
    <a href={`${EN_BASE}/categories/`} class="stat-card">
      <strong>{NAMES.length}</strong>
      <span>Names in the database</span>
    </a>
  </section>

  <section>
    <h2>Name categories</h2>
    <p>Pick a meaning theme for your child’s name.</p>
    <div class="card-grid">
      {featuredThemes.map(([slug, theme]) => {
        const count = getNamesByTheme(slug).length;
        return (
          <a class="card" href={`${EN_BASE}/categories/${slug}/`}>
            <h3>{theme.labelEn}</h3>
            <p>{count} names · {theme.blurbEn}</p>
          </a>
        );
      })}
    </div>
    <p style="margin-top: 1rem">
      <a href={`${EN_BASE}/categories/`}>All name categories →</a>
    </p>
  </section>

  <section>
    <h2>All names</h2>
    <p>Use the search box or letter filters above to narrow the list.</p>
    <NameList names={allNames} lang="en" />
  </section>

  <section class="prose">
    <h2>Bahasa Melayu</h2>
    <p>
      Malay hub:
      <a href={`${NAMA_BAYI_BASE}/`}>Nama Bayi Islam</a>.
    </p>
  </section>
</BaseLayout>
