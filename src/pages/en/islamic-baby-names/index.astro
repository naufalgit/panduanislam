---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NameList from '../../../components/NameList.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { NAMES, getLettersWithNames, getNamesByTheme } from '../../../data/names';
import { EN_BASE, NAMA_BAYI_BASE, THEMES } from '../../../consts';

const letters = getLettersWithNames();
const boyCount = NAMES.filter((n) => n.gender === 'lelaki' || n.gender === 'unisex').length;
const girlCount = NAMES.filter((n) => n.gender === 'perempuan' || n.gender === 'unisex').length;
const featuredThemes = Object.entries(THEMES).slice(0, 6);
const popular = [...NAMES].sort((a, b) => a.name.localeCompare(b.name, 'en')).slice(0, 12);

const title = 'Islamic Baby Names with Meaning';
const description = `Browse ${NAMES.length}+ Islamic baby names for boys and girls with meanings — a practical guide for Muslim parents in Malaysia.`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`${EN_BASE}/islamic-baby-names/`}
  lang="en"
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={`${EN_BASE}/`}>English</a> / <span>Islamic baby names</span>
  </nav>

  <section class="hero">
    <p class="eyebrow">English guide · Malaysia</p>
    <h1>{title}</h1>
    <p class="lead">
      Looking for Islamic baby names with beautiful meanings? Start here with English meanings,
      then explore boy and girl lists used by Muslim families in Malaysia.
    </p>
    <div class="hero-actions">
      <a class="btn" href={`${EN_BASE}/muslim-boy-names/`}>Muslim boy names</a>
      <a class="btn btn-ghost" href={`${EN_BASE}/muslim-girl-names/`}>Muslim girl names</a>
    </div>
  </section>

  <AdSlot slot="en-islamic-baby-names" />

  <section class="grid-stats">
    <a href={`${EN_BASE}/muslim-boy-names/`} class="stat-card">
      <strong>{boyCount}</strong>
      <span>Boy &amp; unisex names</span>
    </a>
    <a href={`${EN_BASE}/muslim-girl-names/`} class="stat-card">
      <strong>{girlCount}</strong>
      <span>Girl &amp; unisex names</span>
    </a>
    <a href={`${NAMA_BAYI_BASE}/`} class="stat-card">
      <strong>{NAMES.length}</strong>
      <span>Names in the database</span>
    </a>
  </section>

  <section class="prose">
    <h2>How to choose an Islamic baby name</h2>
    <p>
      A good Muslim baby name should have a positive meaning, be easy to pronounce in daily life,
      and sit well with your family name. Many Malaysian parents search in English
      (“Islamic baby names”) then shortlist names that still feel natural in Bahasa Melayu.
    </p>
    <ul>
      <li>Prefer meanings tied to blessing, light, piety, wisdom, or kindness.</li>
      <li>Say the full name out loud — at home, at school, and on official forms.</li>
      <li>Keep 3–5 finalists before the baby arrives.</li>
    </ul>
    <p>
      Prefer Bahasa Melayu?
      <a href={`${NAMA_BAYI_BASE}/`}>Lihat panduan Nama Bayi Islam</a>.
    </p>
  </section>

  <section>
    <h2>Browse by letter</h2>
    <p>Islamic baby names starting with A–Z.</p>
    <div class="letter-grid">
      {letters.map((L) => (
        <a href={`${NAMA_BAYI_BASE}/huruf/${L.toLowerCase()}/`}>{L}</a>
      ))}
    </div>
  </section>

  <section>
    <h2>Browse by meaning</h2>
    <p>Themes many parents search for when choosing a Muslim baby name.</p>
    <div class="card-grid">
      {featuredThemes.map(([slug, theme]) => {
        const count = getNamesByTheme(slug).length;
        return (
          <a class="card" href={`${NAMA_BAYI_BASE}/makna/${slug}/`}>
            <h3>{theme.title.replace('Nama Bayi Islam Bermaksud ', '')}</h3>
            <p>{count} names</p>
          </a>
        );
      })}
    </div>
  </section>

  <section>
    <h2>Popular Islamic baby names to start with</h2>
    <p>Open any name for the full English entry (Malay meaning included).</p>
    <NameList names={popular} lang="en" />
  </section>

  <section>
    <h2>More guides</h2>
    <div class="card-grid">
      <a class="card" href={`${EN_BASE}/muslim-boy-names/`}>
        <h3>Muslim boy names</h3>
        <p>Islamic baby boy names with meaning for parents in Malaysia.</p>
      </a>
      <a class="card" href={`${EN_BASE}/muslim-girl-names/`}>
        <h3>Muslim girl names</h3>
        <p>Islamic baby girl names with meaning and themes.</p>
      </a>
      <a class="card" href={`${NAMA_BAYI_BASE}/blog/cara-pilih-nama-bayi-islam/`}>
        <h3>How to choose (Malay guide)</h3>
        <p>Practical tips for new parents — in Bahasa Melayu.</p>
      </a>
    </div>
  </section>
</BaseLayout>
