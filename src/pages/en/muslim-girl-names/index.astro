---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NameList from '../../../components/NameList.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getNamesByGender } from '../../../data/names';
import { EN_BASE, NAMA_BAYI_BASE } from '../../../consts';

const names = getNamesByGender('perempuan');
const sample = names.slice(0, 24);
const title = 'Muslim Girl Names with Meaning';
const description = `${names.length} Muslim girl names (including unisex) with English meanings — for families in Malaysia.`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`${EN_BASE}/muslim-girl-names/`}
  lang="en"
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={`${EN_BASE}/`}>English</a> /
    <a href={`${EN_BASE}/islamic-baby-names/`}>Islamic baby names</a> /
    <span>Girl names</span>
  </nav>

  <h1>{title}</h1>
  <p class="lead">
    {names.length} Muslim girl names with English meanings. Sample list below; open a name for
    details.
  </p>

  <AdSlot slot="en-muslim-girl-names" />

  <section class="prose">
    <h2>Quick tips</h2>
    <p>
      Look for a good meaning, easy pronunciation in Malay and English, and a full name that
      sounds right with your family name.
    </p>
    <p>
      Full Malay list:
      <a href={`${NAMA_BAYI_BASE}/perempuan/`}>Nama bayi Islam perempuan</a>
      ·
      <a href={`${EN_BASE}/muslim-boy-names/`}>Boy names</a>
      ·
      <a href={`${EN_BASE}/islamic-baby-names/`}>All Islamic baby names</a>
    </p>
  </section>

  <section>
    <h2>Sample girl names</h2>
    <NameList names={sample} lang="en" />
    <p style="margin-top: 1.25rem">
      <a class="btn" href={`${EN_BASE}/islamic-baby-names/`}>All Islamic baby names</a>
    </p>
  </section>
</BaseLayout>
