---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { THEMES, EN_BASE, EN_NAMES_BASE } from '../../../../consts';
import { getNamesByTheme } from '../../../../data/names';

const title = 'Islamic Baby Name Categories';
const description =
  'Browse Islamic names by category: provision, mercy, righteousness, light, beauty, and more.';
---

<BaseLayout title={title} description={description} canonicalPath={`${EN_NAMES_BASE}/categories/`} lang="en">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={`${EN_BASE}/`}>English</a> /
    <a href={`${EN_NAMES_BASE}/`}>Islamic names</a> /
    <span>Name categories</span>
  </nav>
  <h1>{title}</h1>
  <p class="lead">{description}</p>
  <div class="card-grid">
    {Object.entries(THEMES).map(([slug, theme]) => {
      const count = getNamesByTheme(slug).length;
      return (
        <a class="card" href={`${EN_NAMES_BASE}/categories/${slug}/`}>
          <h3>{theme.labelEn}</h3>
          <p>{count} names · {theme.blurbEn}</p>
        </a>
      );
    })}
  </div>
</BaseLayout>
