---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import AdSlot from '../../../../../components/AdSlot.astro';
import AffiliateNote from '../../../../../components/AffiliateNote.astro';
import PronounceButton from '../../../../../components/PronounceButton.astro';
import { EN_BASE, EN_NAMES_BASE, NAMA_ISLAM_BASE, THEMES } from '../../../../../consts';
import {
  genderLabelEn,
  getNameBySlug,
  getRelatedNames,
  NAMES,
} from '../../../../../data/names';

export function getStaticPaths() {
  return NAMES.map((n) => ({
    params: { slug: n.slug },
  }));
}

const { slug } = Astro.params;
const name = getNameBySlug(slug!);

if (!name) {
  throw new Error(`Name not found: ${slug}`);
}

const related = getRelatedNames(name);
const letter = name.name[0]!.toUpperCase();
const title = `${name.name} — Islamic Name Meaning`;
const description = `Meaning of the Islamic name ${name.name}: ${name.meaningEn}. Origin: ${name.originEn}. For Muslim parents in Malaysia.`;
const msPath = `${NAMA_ISLAM_BASE}/nama/${name.slug}/`;
const enPath = `${EN_NAMES_BASE}/name/${name.slug}/`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={enPath}
  lang="en"
  alternates={[
    { lang: 'en', path: enPath },
    { lang: 'ms', path: msPath },
    { lang: 'x-default', path: msPath },
  ]}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={`${EN_BASE}/`}>English</a> /
    <a href={`${EN_NAMES_BASE}/`}>Islamic names</a> /
    <span>{name.name}</span>
  </nav>

  <article>
    <h1>{name.name}</h1>
    <PronounceButton text={name.name} slug={name.slug} lang="en" />
    <p class="lead">
      <strong>Meaning:</strong> {name.meaningEn}
    </p>
    <p>
      <strong>Bahasa Melayu:</strong> {name.meaning}
    </p>

    <div class="tag-row">
      <span class="tag">{genderLabelEn(name.gender)}</span>
      <span class="tag">Origin: {name.originEn}</span>
      <a class="tag" href={`${NAMA_ISLAM_BASE}/?huruf=${letter.toLowerCase()}`}>Letter {letter}</a>
      {name.themes.map((t) =>
        THEMES[t] ? (
          <a class="tag" href={`${EN_NAMES_BASE}/categories/${t}/`}>{THEMES[t].labelEn}</a>
        ) : null,
      )}
    </div>

    <AdSlot slot={`en-nama-${name.slug}`} />

    <div class="prose">
      <h2>About {name.name}</h2>
      <p>
        <strong>{name.name}</strong> is a {genderLabelEn(name.gender).toLowerCase()} Islamic baby
        name from <strong>{name.originEn}</strong>. Meaning: “{name.meaningEn}”.
      </p>
      <p>
        Malay page:
        <a href={msPath}>{name.name}</a>
        ·
        <a href={`${EN_NAMES_BASE}/`}>Islamic names</a>
        ·
        <a href={`${EN_NAMES_BASE}/boys/`}>Boy names</a>
        ·
        <a href={`${EN_NAMES_BASE}/girls/`}>Girl names</a>
      </p>
      <p class="meta">General naming information only — not a fatwa.</p>
    </div>

    <section>
      <h2>Related names</h2>
      <ul class="name-list">
        {related.map((n) => (
          <li>
            <a href={`${EN_NAMES_BASE}/name/${n.slug}/`}>
              <strong>{n.name}</strong>
              <span>{n.meaningEn}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <AffiliateNote />
  </article>
</BaseLayout>
