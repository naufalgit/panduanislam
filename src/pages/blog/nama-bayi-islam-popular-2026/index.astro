---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSlot from '../../../components/AdSlot.astro';

const title = 'Nama Bayi Islam Popular 2026';
const description =
  'Senarai inspirasi nama bayi Islam popular untuk 2026 di Malaysia — fokus nama pendek, bermaksud baik, dan mudah disebut.';
---

<BaseLayout title={title} description={description} canonicalPath="/blog/nama-bayi-islam-popular-2026/" type="article">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Laman utama</a> / <span>Panduan</span>
  </nav>
  <article class="prose">
    <h1>{title}</h1>
    <p class="meta">Inspirasi evergreen untuk tahun 2026 — dikemas kini bersama pangkalan nama kami.</p>
    <AdSlot slot="blog-2026" />
    <p>
      Ibu bapa pada 2026 masih cenderung memilih nama yang mudah disebut, bermaksud positif,
      dan sesuai untuk dokumen rasmi Malaysia. Berikut idea pantas:
    </p>
    <h2>Lelaki</h2>
    <ul>
      <li><a href="/nama/aadam/">Aadam</a></li>
      <li><a href="/nama/amir/">Amir</a></li>
      <li><a href="/nama/irfan/">Irfan</a></li>
      <li><a href="/nama/naufal/">Naufal</a></li>
      <li><a href="/nama/zayd/">Zayd</a></li>
    </ul>
    <h2>Perempuan</h2>
    <ul>
      <li><a href="/nama/alia/">Alia</a></li>
      <li><a href="/nama/humaira/">Humaira</a></li>
      <li><a href="/nama/liyana/">Liyana</a></li>
      <li><a href="/nama/sofia/">Sofia</a></li>
      <li><a href="/nama/zara/">Zara</a></li>
    </ul>
    <p>
      Untuk senarai lebih lengkap, lawati <a href="/lelaki/">nama lelaki</a>,
      <a href="/perempuan/">nama perempuan</a>, atau tema
      <a href="/makna/mulia/">mulia</a> dan <a href="/makna/cantik/">cantik</a>.
    </p>
  </article>
</BaseLayout>
