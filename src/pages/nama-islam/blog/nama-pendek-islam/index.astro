---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import AdSlot from '../../../../components/AdSlot.astro';

const title = 'Nama Pendek Islam untuk Bayi';
const description =
  'Idea nama pendek Islam (2–3 suku kata) untuk bayi lelaki dan perempuan — mudah disebut dan diguna harian.';
---

<BaseLayout title={title} description={description} canonicalPath="/nama-islam/blog/nama-pendek-islam/" type="article">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Laman utama</a> / <a href="/nama-islam/">Nama Islam</a> / <span>Panduan</span>
  </nav>
  <article class="prose">
    <h1>{title}</h1>
    <AdSlot slot="blog-pendek" />
    <p>
      Nama pendek memudahkan panggilan harian, borang rasmi, dan sebutan di sekolah.
      Beberapa contoh dalam pangkalan kami:
    </p>
    <ul>
      <li><a href="/nama-islam/nama/ali/">Ali</a></li>
      <li><a href="/nama-islam/nama/noor/">Noor</a></li>
      <li><a href="/nama-islam/nama/nurul/">Nurul</a></li>
      <li><a href="/nama-islam/nama/hana/">Hana</a></li>
      <li><a href="/nama-islam/nama/iman/">Iman</a></li>
      <li><a href="/nama-islam/nama/saif/">Saif</a></li>
      <li><a href="/nama-islam/nama/aya/">Aya</a></li>
      <li><a href="/nama-islam/nama/zia/">Zia</a></li>
    </ul>
    <p>
      Teroka lebih banyak melalui <a href="/nama-islam/?huruf=a">huruf A–Z</a> atau kategori
      <a href="/nama-islam/makna/tenang/">tenang</a> dan <a href="/nama-islam/makna/kasih/">kasih</a>.
    </p>
  </article>
</BaseLayout>
