---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import AdSlot from '../../../../components/AdSlot.astro';
import AffiliateNote from '../../../../components/AffiliateNote.astro';
import PronounceButton from '../../../../components/PronounceButton.astro';
import { THEMES } from '../../../../consts';
import {
  genderLabel,
  getNameBySlug,
  getRelatedNames,
  NAMES,
} from '../../../../data/names';

export function getStaticPaths() {
  return NAMES.map((n) => ({
    params: { slug: n.slug },
  }));
}

const { slug } = Astro.params;
const name = getNameBySlug(slug!);

if (!name) {
  throw new Error(`Name not found: ${slug}`);
}

const related = getRelatedNames(name);
const letter = name.name[0]!.toUpperCase();
const title = `Nama ${name.name} — Maksud & Asal Usul`;
const description = `Maksud nama ${name.name}: ${name.meaning}. Asal usul ${name.origin}. Nama bayi Islam ${genderLabel(name.gender).toLowerCase()}.`;
const msPath = `/nama-islam/nama/${name.slug}/`;
const enPath = `/en/islamic-names/name/${name.slug}/`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={msPath}
  alternates={[
    { lang: 'ms', path: msPath },
    { lang: 'en', path: enPath },
    { lang: 'x-default', path: msPath },
  ]}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Laman utama</a> / <a href="/nama-islam/">Nama Islam</a> /
    <a href={name.gender === 'perempuan' ? '/nama-islam/perempuan/' : '/nama-islam/lelaki/'}>
      {name.gender === 'unisex' ? 'Unisex' : genderLabel(name.gender)}
    </a>
    /
    <span>{name.name}</span>
  </nav>

  <article>
    <h1>Nama {name.name}</h1>
    <PronounceButton text={name.name} lang="ms" />
    <p class="lead">
      <strong>Maksud:</strong> {name.meaning}
    </p>
    <p>
      <strong>English meaning:</strong> {name.meaningEn}
    </p>

    <div class="tag-row">
      <span class="tag">{genderLabel(name.gender)}</span>
      <span class="tag">Asal: {name.origin}</span>
      <a class="tag" href={`/nama-islam/?huruf=${letter.toLowerCase()}`}>Huruf {letter}</a>
      {name.themes.map((t) =>
        THEMES[t] ? (
          <a class="tag" href={`/nama-islam/makna/${t}/`}>{THEMES[t].label}</a>
        ) : null,
      )}
    </div>

    <AdSlot slot={`nama-${name.slug}`} />

    <div class="prose">
      <h2>Tentang nama {name.name}</h2>
      <p>
        <strong>{name.name}</strong> ialah nama bayi Islam {genderLabel(name.gender).toLowerCase()}
        daripada bahasa <strong>{name.origin}</strong>. Maksud: “{name.meaning}”. English:
        “{name.meaningEn}”.
      </p>
      <p>
        Lihat juga
        <a href={`/nama-islam/?huruf=${letter.toLowerCase()}`}>nama bermula dengan {letter}</a>
        {name.themes[0] && THEMES[name.themes[0]] && (
          <>
            {' '}
            dan kategori
            <a href={`/nama-islam/makna/${name.themes[0]}/`}>
              {' '}
              {THEMES[name.themes[0]].label}
            </a>
          </>
        )}
        . Halaman English:
        <a href={`/en/islamic-names/name/${name.slug}/`}>{name.name}</a>.
      </p>
    </div>

    <section>
      <h2>Nama berkaitan</h2>
      <ul class="name-list">
        {related.map((n) => (
          <li>
            <a href={`/nama-islam/nama/${n.slug}/`}>
              <strong>{n.name}</strong>
              <span>{n.meaning}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <AffiliateNote />
  </article>
</BaseLayout>
