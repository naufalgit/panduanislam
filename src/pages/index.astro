---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAMES } from '../data/names';
import { NAMA_ISLAM_BASE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<BaseLayout title={`${SITE_TITLE} — Panduan untuk Muslim Malaysia`} description={SITE_DESCRIPTION}>
  <section class="hero">
    <p class="eyebrow">Malaysia · Bahasa Melayu</p>
    <h1>{SITE_TITLE}</h1>
    <p class="lead">
      Panduan praktikal untuk kehidupan Muslim di Malaysia. Kami mula dengan
      <strong>nama Islam</strong> untuk bayi dan anak — dan akan menambah topik lain seperti doa,
      solat dan zakat sepanjang tahun.
    </p>
    <div class="hero-actions">
      <a class="btn" href={`${NAMA_ISLAM_BASE}/`}>Teroka nama Islam</a>
      <a class="btn btn-ghost" href={`${NAMA_ISLAM_BASE}/lelaki/`}>Nama lelaki</a>
      <a class="btn btn-ghost" href={`${NAMA_ISLAM_BASE}/perempuan/`}>Nama perempuan</a>
    </div>
  </section>

  <section>
    <h2>Fokus sekarang</h2>
    <div class="card-grid">
      <a class="card" href={`${NAMA_ISLAM_BASE}/`}>
        <h3>Nama Islam</h3>
        <p>{NAMES.length}+ nama untuk bayi &amp; anak, dengan maksud dan kategori.</p>
      </a>
      <a class="card" href={`${NAMA_ISLAM_BASE}/blog/cara-pilih-nama-bayi-islam/`}>
        <h3>Cara pilih nama</h3>
        <p>Panduan ringkas untuk ibu bapa baharu di Malaysia.</p>
      </a>
      <a class="card" href={`${NAMA_ISLAM_BASE}/makna/rezeki/`}>
        <h3>Nama bermaksud rezeki</h3>
        <p>Satu tema yang kerap dicari.</p>
      </a>
    </div>
  </section>

  <section>
    <h2>Akan datang</h2>
    <p class="lead">
      Doa harian, waktu solat, zakat dan panduan lain — selepas bahagian nama bayi lebih lengkap.
    </p>
  </section>
</BaseLayout>
