---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAMES } from '../data/names';
import { NAMA_BAYI_BASE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<BaseLayout title={`${SITE_TITLE} — Panduan untuk Muslim Malaysia`} description={SITE_DESCRIPTION}>
  <section class="hero">
    <p class="eyebrow">Malaysia · Bahasa Melayu</p>
    <h1>{SITE_TITLE}</h1>
    <p class="lead">
      Panduan praktikal untuk kehidupan Muslim di Malaysia. Kami mula dengan
      <strong>nama bayi Islam</strong> — dan akan menambah topik lain seperti doa,
      solat dan zakat sepanjang tahun.
    </p>
    <div class="hero-actions">
      <a class="btn" href={`${NAMA_BAYI_BASE}/`}>Teroka nama bayi Islam</a>
      <a class="btn btn-ghost" href={`${NAMA_BAYI_BASE}/lelaki/`}>Nama lelaki</a>
      <a class="btn btn-ghost" href={`${NAMA_BAYI_BASE}/perempuan/`}>Nama perempuan</a>
    </div>
  </section>

  <section>
    <h2>Pillar utama sekarang</h2>
    <div class="card-grid">
      <a class="card" href={`${NAMA_BAYI_BASE}/`}>
        <h3>Nama Bayi Islam</h3>
        <p>{NAMES.length}+ nama dengan maksud, huruf A–Z, dan tema seperti rezeki &amp; cahaya.</p>
      </a>
      <a class="card" href={`${NAMA_BAYI_BASE}/blog/cara-pilih-nama-bayi-islam/`}>
        <h3>Cara pilih nama</h3>
        <p>Panduan ringkas untuk ibu bapa baharu di Malaysia.</p>
      </a>
      <a class="card" href={`${NAMA_BAYI_BASE}/makna/rezeki/`}>
        <h3>Nama bermaksud rezeki</h3>
        <p>Tema popular yang sering dicari ibu bapa.</p>
      </a>
    </div>
  </section>

  <section>
    <h2>Akan datang</h2>
    <p class="lead">
      Doa harian, waktu solat, zakat dan panduan lain — dibina selepas asas nama bayi stabil.
    </p>
  </section>
</BaseLayout>
