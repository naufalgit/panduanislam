---
import { NAMA_BAYI_BASE } from '../consts';
import { genderLabel, type BabyName, type Gender } from '../data/names';

interface Props {
  names: BabyName[];
  lang?: 'ms' | 'en';
}

const { names, lang = 'ms' } = Astro.props;

function label(gender: Gender): string {
  if (lang === 'en') {
    if (gender === 'lelaki') return 'Boy';
    if (gender === 'perempuan') return 'Girl';
    return 'Unisex';
  }
  return genderLabel(gender);
}
---

<ul class="name-list">
  {names.map((n) => (
    <li>
      <a href={`${NAMA_BAYI_BASE}/nama/${n.slug}/`}>
        <strong>{n.name}</strong>
        <span>{label(n.gender)} · {n.meaning}</span>
      </a>
    </li>
  ))}
</ul>
