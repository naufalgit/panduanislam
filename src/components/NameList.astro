---
import { EN_NAMES_BASE, NAMA_ISLAM_BASE } from '../consts';
import { genderLabel, genderLabelEn, type BabyName } from '../data/names';

interface Props {
  names: BabyName[];
  lang?: 'ms' | 'en';
}

const { names, lang = 'ms' } = Astro.props;
---

<ul class="name-list">
  {names.map((n) => (
    <li
      data-name-item
      data-letter={n.name[0]!.toLowerCase()}
      data-q={`${n.name} ${lang === 'en' ? n.meaningEn : n.meaning}`.toLowerCase()}
    >
      <a href={lang === 'en' ? `${EN_NAMES_BASE}/name/${n.slug}/` : `${NAMA_ISLAM_BASE}/nama/${n.slug}/`}>
        <strong>{n.name}</strong>
        <span>
          {lang === 'en' ? genderLabelEn(n.gender) : genderLabel(n.gender)} ·{' '}
          {lang === 'en' ? n.meaningEn : n.meaning}
        </span>
      </a>
    </li>
  ))}
</ul>
