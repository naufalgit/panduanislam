---
interface Props {
  text: string;
  slug: string;
  lang?: 'ms' | 'en';
}

const { text, slug, lang = 'ms' } = Astro.props;
const audioSrc = `/audio/nama/${slug}.mp3`;
const label = lang === 'en' ? 'Play pronunciation' : 'Dengar sebutan';
const hint =
  lang === 'en'
    ? 'Clear Malay pronunciation of the name.'
    : 'Sebutan jelas nama dalam Bahasa Melayu.';
---

<div class="pronounce" data-pronounce data-audio={audioSrc} data-name={text}>
  <button type="button" class="btn btn-ghost pronounce-btn" data-pronounce-btn>
    {label}
  </button>
  <p class="meta pronounce-hint">{hint}</p>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-pronounce]');
    if (!root) return;

    var btn = root.querySelector('[data-pronounce-btn]');
    var src = root.getAttribute('data-audio') || '';
    if (!btn || !src) return;

    var audio = null;

    function play() {
      if (!audio) {
        audio = new Audio(src);
        audio.preload = 'none';
      }
      audio.pause();
      audio.currentTime = 0;
      var p = audio.play();
      if (p && typeof p.catch === 'function') {
        p.catch(function () {
          btn.disabled = true;
          btn.textContent = btn.textContent.indexOf('Play') === 0 ? 'Audio unavailable' : 'Audio tidak tersedia';
        });
      }
    }

    btn.addEventListener('click', play);
  })();
</script>
