---
import { ADSENSE_CLIENT } from '../consts';

interface Props {
  slot?: string;
}

const { slot: slotName = 'default' } = Astro.props;
const ready = Boolean(ADSENSE_CLIENT);
---

{
  ready ? (
    <aside class="ad-slot" data-ad-slot={slotName} aria-label="Iklan">
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot="0000000000"
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
      <script is:inline>
        window.adsbygoogle = window.adsbygoogle || [];
        window.adsbygoogle.push({});
      </script>
    </aside>
  ) : null
}
