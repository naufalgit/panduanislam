{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/nama-bayi/huruf/:letter",
      "destination": "/nama-bayi/?huruf=:letter",
      "permanent": true
    },
    {
      "source": "/nama-bayi/huruf/:letter/",
      "destination": "/nama-bayi/?huruf=:letter",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
